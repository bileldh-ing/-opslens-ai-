# ── Database ──────────────────────────────────────────────────────────────
# Zero-config: embedded Postgres 17 + pgvector (PGlite), stored in ./.data
DATABASE_URL=pglite://.data/opslens
# Production / docker compose:
# DATABASE_URL=postgres://opslens:opslens@localhost:5432/opslens

# ── Redis (optional) ──────────────────────────────────────────────────────
# Unset: in-process rate limiting and inline jobs. Set: BullMQ worker + Redis rate limits.
# REDIS_URL=redis://localhost:6379

# ── AI provider (optional) ────────────────────────────────────────────────
# Unset: deterministic triage analyst + local hashing embeddings (demo mode).
# Any OpenAI-compatible endpoint works (set AI_BASE_URL for Ollama/Groq/Azure…).
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=http://localhost:11434/v1
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

APP_URL=http://localhost:3000
